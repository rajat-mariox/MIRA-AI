# ---------------------------------------------------------------
# MIRAI backend environment variables. Copy to .env and fill in.
# All values are validated at startup by src/config/env.ts (zod).
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development            # development | test | production
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000   # public URL of this API (used for building absolute links, e.g. uploads)
# CORS: "*" (any origin; fine for local dev) or a comma-separated list of exact origins (no trailing slash).
# Browsers calling this API directly: the public website (mirai-react, POST /leads; Vite dev on
# http://localhost:5173, or 5174 when 5173 is taken) and the admin panel when it is not behind the
# Vite dev proxy. The mobile app is not affected by CORS. Production example:
#   CORS_ORIGINS=https://miraiastro.com,https://www.miraiastro.com,https://admin.miraiastro.com
# Local example without "*":
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
CORS_ORIGINS=*
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=0                   # proxy hops to trust for client IP (1 behind nginx/ALB)

# --- Data stores ---
MONGODB_URI=mongodb://127.0.0.1:27017/mirai
REDIS_URL=                      # e.g. redis://127.0.0.1:6379 ; empty = in-memory cache (single process)

# --- JWT (use long random strings, min 32 chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES=30d
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-chars
JWT_ADMIN_EXPIRES=1d

# --- OTP (passwordless email login) ---
OTP_LENGTH=4                    # 4-6 digits (mobile app UI has 4 boxes)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# When set AND NODE_ENV != production, this OTP is ALWAYS accepted for any email
# (in addition to the real one). Handy for local dev / QA. Ignored in production.
DEV_FIXED_OTP=

# --- SMTP (if SMTP_HOST is empty, OTP emails are logged to the console instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MIRAI <no-reply@miraiastro.com>"

# --- Third-party (used by future modules) ---
DIVINE_API_KEY=                 # Divine API (horoscope / panchang / kundli)
DIVINE_AUTH_TOKEN=
DIVINE_USE_TRANSLATOR=false     # true = Hindi via Divine "-translator" hosts (enable Translator in Divine dashboard first); false = always English
ANTHROPIC_API_KEY=              # AI chat (empty -> POST /chat/sessions/:id/messages returns 503)
AI_PROVIDER=anthropic           # anthropic | openai | mock (mock = canned replies for dev/QA; ignored in production)
ANTHROPIC_MODEL=claude-sonnet-5-5
CHAT_MAX_TOKENS=1024            # max output tokens per AI reply
CHAT_PRICE_PER_MESSAGE=0        # wallet debit per chat message (0 = free); refunded if the AI call fails
CHAT_RATE_LIMIT_PER_MIN=20      # chat messages per minute per user
CHAT_FREE_QUESTIONS=1           # free AI chat questions per user; after that a plan (GET /plans) is required
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Firebase service-account JSON for push notifications (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Relative paths resolve against this folder.
# Without it push sends answer 503.  e.g. FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Admin ---
# First super admin, created at startup ONLY if the admins collection is empty (change the password after first login).
ADMIN_SEED_EMAIL=admin@miraiastro.com
ADMIN_SEED_PASSWORD=change-me

# --- Website leads (public contact form, POST /leads) ---
LEADS_RATE_LIMIT_PER_HOUR=5     # submissions per hour per IP (429 after that)
# "New lead" e-mail recipient; only sent when SMTP_HOST is set. Empty = ADMIN_SEED_EMAIL.
LEADS_NOTIFY_EMAIL=

# OpenAI chat provider (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Panchang festivals from Google Calendar (public "Holidays in India" calendar). When the key is
# set, festivals come from Google instead of Divine (whose plan may not include festivals).
# Google Cloud Console -> enable "Google Calendar API" -> Credentials -> API key.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_HOLIDAY_CALENDAR_ID=en.indian#holiday@group.v.calendar.google.com

# Scheduled notifications (src/jobs/notificationJobs.ts, Asia/Kolkata): daily horoscope 07:00,
# weekly horoscope Monday 08:00, festival alerts 08:00, muhurat 06:30. Respects users'
# notificationPrefs; deduped per user per day. true = don't run them in this process.
NOTIFICATION_JOBS_DISABLED=false
