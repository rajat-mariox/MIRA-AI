# Used by `npm run dev` (overrides .env). VITE_USE_MOCK=true runs the panel on dummy data from
# src/mocks/mockApi.ts (login admin@mira.ai / admin123). To use the real backend locally, create
# .env.development.local with VITE_USE_MOCK=false (the Vite dev proxy sends /api and /uploads to
# http://localhost:5000). Note: .env.local cannot override this file.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1
